generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Shortened URL record. `code` stores either a generated short code or a custom alias.
model Link {
  id          String   @id @default(cuid())
  code        String   @unique
  destination String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  clicks      Click[]

  @@index([createdAt])
}

/// Click event captured on successful redirect. Analytics UI comes in a later milestone.
model Click {
  id        String   @id @default(cuid())
  linkId    String
  link      Link     @relation(fields: [linkId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([linkId])
  @@index([createdAt])
  @@index([linkId, createdAt])
}
